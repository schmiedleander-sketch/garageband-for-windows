#define IDI_APPICON 101
#define VS_VERSION_INFO 1

IDI_APPICON ICON "../src/assets/icons/garageband.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "GarageBand Windows Project"
            VALUE "FileDescription",  "GarageBand for Windows - Digital Audio Workstation"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "GarageBand"
            VALUE "LegalCopyright",   "© 2026 GarageBand for Windows. All rights reserved."
            VALUE "OriginalFilename", "GarageBand.exe"
            VALUE "ProductName",      "GarageBand for Windows"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "Safe, verified, real native Windows audio application."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
